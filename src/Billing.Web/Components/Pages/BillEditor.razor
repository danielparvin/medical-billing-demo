@page "/bills/new"
@page "/bills/{Id:int}"
@using System.Globalization
@inject BillingApiClient Api
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@(Id is null ? "New bill" : $"Bill #{Id}")</h1>
    <a class="btn btn-outline-secondary btn-sm" href="/bills">Back to bills</a>
</div>

@if (_loading)
{
    <p class="text-muted">Loading…</p>
}
else
{
    @if (_error is not null)
    {
        <div class="alert alert-danger" role="alert" data-testid="error">@_error</div>
    }

    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-sm-4">
                    <label class="form-label" for="patientRef">Patient ref</label>
                    <input id="patientRef" class="form-control" @bind="_model.PatientRef" />
                </div>
                <div class="col-sm-4">
                    <label class="form-label" for="dateOfService">Date of service</label>
                    <input id="dateOfService" class="form-control" type="date" @bind="_model.DateOfService" />
                </div>
                @if (_result is not null)
                {
                    <div class="col-sm-4 text-sm-end">
                        <span class="badge text-bg-success me-2" data-testid="status">@_result.Status</span>
                        <span class="fs-5" data-testid="total">Total allowed: <strong class="font-monospace">@Format(_result.TotalAllowed)</strong></span>
                    </div>
                }
            </div>
        </div>
    </div>

    <table class="table align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th><th>Code</th><th class="text-center">-50</th><th class="text-center">-26</th>
                <th>Units</th><th>Billed</th><th class="text-end">Allowed</th><th>Pricing</th><th></th>
            </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < _model.Lines.Count; i++)
        {
            var line = _model.Lines[i];
            var index = i;
            var outcome = _result?.Lines.FirstOrDefault(r => r.LineNumber == line.LineNumber);
            <tr data-testid="line-row">
                <td class="text-muted">@line.LineNumber</td>
                <td>
                    <input class="code form-control form-control-sm @(ShowCodeError(line) ? "is-invalid" : "")" style="max-width: 7rem" maxlength="@LineEditModel.ProcedureCodeLength" @bind="line.ProcedureCode" />
                    @if (ShowCodeError(line))
                    {
                        <div class="invalid-feedback" data-testid="code-error">Enter exactly 5 letters or digits.</div>
                    }
                </td>
                <td class="text-center"><input class="mod50 form-check-input" type="checkbox" @bind="line.Modifier50" /></td>
                <td class="text-center"><input class="mod26 form-check-input" type="checkbox" @bind="line.Modifier26" /></td>
                <td><input class="units form-control form-control-sm" style="max-width: 5rem" type="number" @bind="line.Units" /></td>
                <td><input class="billed form-control form-control-sm" style="max-width: 8rem" type="number" step="0.01" @bind="line.BilledAmount" /></td>
                <td class="text-end font-monospace" data-testid="allowed">@Format(outcome?.AllowedAmount)</td>
                <td>
                    @if (outcome?.PricingStatus is not null)
                    {
                        <span class="badge @(outcome.PricingStatus == "Priced" ? "text-bg-success" : "text-bg-warning")">@outcome.PricingStatus</span>
                    }
                    @if (outcome?.UnpricedReason is not null)
                    {
                        <small class="text-muted ms-1">(@outcome.UnpricedReason)</small>
                    }
                    @if (outcome is { Adjustments.Count: > 0 })
                    {
                        <details class="small mt-1">
                            <summary>Audit trail</summary>
                            <ol class="mb-0 ps-3 font-monospace">
                            @foreach (var step in outcome.Adjustments)
                            {
                                <li>@step.Step @(step.Factor is null ? "" : $"× {step.Factor.Value.ToString("0.######", CultureInfo.InvariantCulture)}") = @step.ResultingAmount.ToString("0.######", CultureInfo.InvariantCulture)</li>
                            }
                            </ol>
                        </details>
                    }
                </td>
                <td class="text-end"><button class="remove-line btn btn-outline-danger btn-sm" type="button" @onclick="() => RemoveLine(index)">Remove</button></td>
            </tr>
        }
        </tbody>
    </table>

    <div class="d-flex gap-2">
        <button id="add-line" class="btn btn-outline-secondary" type="button" @onclick="AddLine">Add line</button>
        <button id="save" class="btn btn-secondary ms-auto" type="button" disabled="@_busy" @onclick="SaveAsync">Save</button>
        <button id="process" class="btn btn-primary" type="button" disabled="@_busy" @onclick="ProcessAsync">Process Bill</button>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private BillEditModel _model = BillEditModel.Empty();
    private BillDto? _result;
    private string? _error;
    private bool _loading;
    private bool _busy;
    private int? _loadedId;
    private bool _showCodeErrors;

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null)
        {
            _model = BillEditModel.Empty();
            _result = null;
            _loadedId = null;
            _showCodeErrors = false;
            return;
        }

        if (_loadedId == Id)
        {
            return;
        }

        _loading = true;
        var bill = await Api.GetAsync(Id.Value);
        _loading = false;

        if (bill is null)
        {
            _error = $"Bill {Id} was not found.";
            return;
        }

        Apply(bill);
        _loadedId = Id;
    }

    private void Apply(BillDto bill)
    {
        _model = BillEditModel.FromDto(bill);
        _result = bill.Status == "Processed" ? bill : null;
        _showCodeErrors = false;
    }

    private void AddLine() => _model.AddLine();

    private void RemoveLine(int index) => _model.RemoveLineAt(index);

    /// <summary>A typed code is checked on leaving the field; an untouched empty one only once saving is tried.</summary>
    private bool ShowCodeError(LineEditModel line) =>
        !line.HasValidProcedureCode && (_showCodeErrors || line.ProcedureCode.Length > 0);

    private async Task<BillDto?> SaveCoreAsync()
    {
        if (!_model.Lines.All(l => l.HasValidProcedureCode))
        {
            _showCodeErrors = true;
            _error = "Fix the highlighted codes: each must be exactly 5 letters or digits.";
            return null;
        }

        var request = _model.ToRequest();
        var outcome = Id is null
            ? await Api.CreateAsync(request)
            : await Api.UpdateAsync(Id.Value, request);

        if (outcome.Error is not null)
        {
            _error = outcome.Error;
            return null;
        }

        return outcome.Value;
    }

    private async Task SaveAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var saved = await SaveCoreAsync();
            if (saved is null) return;

            Apply(saved);
            _loadedId = saved.Id;
            if (Id is null) Navigation.NavigateTo($"/bills/{saved.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Process Bill saves the current edits first, then reprices the saved bill.</summary>
    private async Task ProcessAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var saved = await SaveCoreAsync();
            if (saved is null) return;

            _loadedId = saved.Id;
            var processed = await Api.ProcessAsync(saved.Id);
            if (processed.Error is not null)
            {
                _error = processed.Error;
                Apply(saved);
                return;
            }

            Apply(processed.Value!);
            if (Id is null) Navigation.NavigateTo($"/bills/{saved.Id}");
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Format(decimal? value) =>
        value?.ToString("F2", CultureInfo.InvariantCulture) ?? "";
}
